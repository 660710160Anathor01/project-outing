// Company Outing Registration - data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Form {
  id                 String   @id @default(uuid()) @db.Uuid
  registrationNumber String   @unique
  name               String
  phone              String
  lineId             String?
  locationId         String
  follower           Int      @default(0)
  companions         Json     @default("[]")
  travelOption       String   @default("SELF_DRIVE")
  note               String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([locationId])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@map("form")
}
