// Company Outing Registration - data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  description      String?
  address          String
  beds             Int      @default(0)
  residentCapacity Int      @default(0)
  carparkCapacity  Int      @default(0)
  mapUrl           String?
  sourceUrl        String?
  imageUrl         String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

}


model Form {
  id                 String   @id @default(uuid()) @db.Uuid
  registrationNumber String   @unique
  name               String
  phone              String
  lineId             String?
  locationId         String
  companions         Json     @default("[]")
  travelOption       String   @default("SELF_DRIVE")
  carShare           Boolean  @default(false)
  emptySeats         Int      @default(0)
  address            String?
  note               String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([locationId])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@map("form")
}
