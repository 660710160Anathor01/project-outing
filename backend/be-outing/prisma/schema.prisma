// Company Outing Registration - data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  userName         String   @unique
  pass             String
  role             String   @default("USER")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Location {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  description      String?
  address          String
  beds             Int      @default(0)
  residentCapacity Int      @default(0)
  carparkCapacity  Int      @default(0)
  mapUrl           String?
  sourceUrl        String?
  imageUrl         String[]
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

}


model Form {
  id                 String   @id @default(uuid()) @db.Uuid
  registrationNumber String   @unique
  name               String
  phone              String
  lineId             String?
  locationId         String
  companions         Json     @default("[]")
  travelOption       String   @default("SELF_DRIVE")
  carShare           Boolean  @default(false)
  emptySeats         Int      @default(0)
  address            String?
  note               String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paymentHistories PaymentHistory[]

  @@index([locationId])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@map("form")
}

model PaymentCore {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @default("Default Payment")
  amountPerPerson Int
  qrCodeUrl       String?
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentHistories PaymentHistory[]

  @@index([isActive])
  @@map("payment_core")
}

model PaymentHistory {
  id            String   @id @default(uuid()) @db.Uuid

  formId        String   @db.Uuid
  paymentCoreId String   @db.Uuid

  amount        Int
  peopleCount   Int

  slipUrl       String?

  status        String   @default("PENDING")
  paidAt        DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  form          Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  paymentCore   PaymentCore @relation(fields: [paymentCoreId], references: [id])

  @@index([formId])
  @@index([paymentCoreId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_history")
}
