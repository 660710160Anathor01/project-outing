# Copy this file to .env and fill in real values. .env is git-ignored.
# Never commit a real DATABASE_URL.

# PostgreSQL connection string used by Prisma (migrations, seed) and the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/outing?schema=public"

# development | test | production
NODE_ENV="development"

# Max PostgreSQL connections this process will open. Keep it at or below the
# limit your database allows; requests queue in the app once it is reached.
DATABASE_POOL_MAX=10

# Port the NestJS API listens on.
PORT=3001

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"

# Rate limiting: max THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds, per client.
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Stricter limit applied to write endpoints (POST/PATCH/DELETE /registrations).
# Note this is per client IP: a whole office behind one NAT address shares the budget.
WRITE_THROTTLE_TTL=60000
WRITE_THROTTLE_LIMIT=30
